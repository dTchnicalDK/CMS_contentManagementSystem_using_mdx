+/**
+ * Scaffolds a new asset YAML file with a generated assetId
+ * (slug + short hash), so the id is never hand-typed.
+ *
+ * Usage:
+ *   npx tsx scripts/new-asset.ts "Harappa City Map" content/assets/history
+ */
+import { randomBytes } from "crypto";
+import { mkdirSync, writeFileSync, existsSync } from "fs";
+import path from "path";
+
+function slugify(title: string): string {
+  return title
+    .toLowerCase()
+    .trim()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/(^-|-$)/g, "");
+}
+
+function shortHash(): string {
+  return randomBytes(2).toString("hex"); // 4 hex chars
+}
+
+function main() {
+  const [, , title, targetDir] = process.argv;
+
+  if (!title || !targetDir) {
+    console.error(
+      'Usage: npx tsx scripts/new-asset.ts "<title>" <target-dir>',
+    );
+    process.exit(1);
+  }
+
+  const slug = slugify(title);
+  const assetId = `${slug}-${shortHash()}`;
+  const fileName = `${slug}.yml`;
+  const filePath = path.join(targetDir, fileName);
+
+  if (existsSync(filePath)) {
+    console.error(`❌ File already exists: ${filePath}`);
+    process.exit(1);
+  }
+
+  mkdirSync(targetDir, { recursive: true });
+
+  const yaml = `assetId: ${assetId}
+type: image
+title: "${title}"
+origin: manual
+resourceKey: "${path.join(path.relative("content/assets", targetDir), slug)}"
+metadata:
+  alt: ""
+  tags: []
+`;
+
+  writeFileSync(filePath, yaml);
+
+  console.log(`✅ Created ${filePath}`);
+  console.log(`   assetId: ${assetId}`);
+}
+
+main();
